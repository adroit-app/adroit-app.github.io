---
import "../styles/fonts.css";
import "../styles/landing.css";
import AppWindow from "../components/AppWindow.astro";
import Screenshot from "../components/Screenshot.astro";

const repository = "https://github.com/adroit-app/Adroit";
const title = "Adroit | An Agent Workspace for people who live in Vim";
const description =
  "Adroit puts Claude Code, Codex, Pi and OpenCode sessions side by side in one window, each in its own terminal interface. You write prompts in a real Neovim and move around with Vim's motions.";
const icon = new URL("/logo/adroit-icon-512.png", Astro.site).href;

const pillars = [
  {
    title: "Any agent, as it is",
    body: "Claude Code, Codex, Pi and OpenCode run in the terminal interfaces they ship, unchanged, side by side. Pick the agent for the work, not the tool for the agent.",
    keys: [["Ctrl+g p", "next profile on a new session"]],
  },
  {
    title: "Writing in Neovim",
    body: "The prompt is a real Neovim, with your motions, operators, registers, mappings and plugins. Not an input line that imitates a few of them.",
    keys: [
      ["i", "write to the session"],
      ["Ctrl+Enter", "send"],
    ],
  },
  {
    title: "Moving in Vim's grammar",
    body: "Panes, the tree of sessions and what is selected are reached with motions and acted on with commands, as text is in Vim. Nothing needs the mouse.",
    keys: [
      ["Ctrl+q h j k l", "move between windows"],
      ["Mod+j", "next session waiting on you"],
    ],
  },
];

const ground = [
  {
    title: "Waiting on you, first",
    body: "Sessions that wait on an answer or a permission are listed again at the bottom of the tree, across every repository, one key apart. The picker lists them first too.",
    href: "/docs/window/#the-tree",
  },
  {
    title: "Sessions outlive the window",
    body: "Sessions and shells run in hosts of their own. Close Adroit and they keep going; open it again, or several windows at once, and they are as they were. If the host itself goes, Adroit offers to bring them back.",
    href: "/docs/getting-started/#when-the-host-goes",
  },
  {
    title: "Grouped the way git is",
    body: "Sessions sit under the repository they run in, with its terminals and worktrees, each worktree's files beside them. The agent names each session once it knows what the work is.",
    href: "/docs/window/#the-tree",
  },
  {
    title: "A plan you can follow",
    body: "Every agent records the plan of its work as a timeline of tasks, and marks each one as it goes. See where a session stands without reading its whole console.",
    href: "/docs/details/#the-timeline",
  },
  {
    title: "The work at hand to read",
    body: "The details panel shows the session, its changes and log through git or jj, its prompts and messages, the files and links it brought up, and its usage, arranged as you like.",
    href: "/docs/details/",
  },
  {
    title: "Pull requests and issues",
    body: "A repository on GitHub lists its open pull requests and issues in the tree. Read one in a tab, with its diffs and checks, or start a session on it in a worktree of its own.",
    href: "/docs/github/",
  },
  {
    title: "Sessions beside sessions",
    body: "A session can open another for a line of work you will want to steer, in a worktree of its own, and talk with the others as peers. Each one still answers to you.",
    href: "/docs/opening-sessions/",
  },
  {
    title: "Documents, drawn",
    body: "Markdown documents open in a viewer drawn in Adroit's theme, diagrams and formulas included, and switch to Neovim with one key. Images open in a lightbox.",
    href: "/docs/window/#viewers",
  },
  {
    title: "On another machine",
    body: "Pair with a work machine and its sessions appear in the same tree, beside this Mac's, from any computer that joins it. Close the lid; the work goes on there.",
    href: "/docs/environments/",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={icon} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Follow the theme chosen in the docs (Starlight keeps it here), else the OS.
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Adroit">
        <img class="on-light" src="/logo/adroit-logo-horizontal.svg" alt="" width="156" height="36" />
        <img class="on-dark" src="/logo/adroit-logo-horizontal-light.svg" alt="" width="156" height="36" />
      </a>
      <nav class="site-nav" aria-label="Site">
        <a href="/docs/">Docs</a>
        <a href="#install">Install</a>
        <a href={repository}>GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">An Agent Workspace for people who live in Vim</p>
        <h1 id="hero-title">Drive every coding agent <em>the way you edit.</em></h1>
        <p class="lede">
          Adroit puts your Claude Code, Codex, Pi and OpenCode sessions side by side in one window, each in the interface
          its agent ships. You write to them in a real Neovim and move between them with Vim's motions, by hand.
        </p>
        <div class="actions">
          <a class="button is-primary" href="#install">Install Adroit</a>
          <a class="button" href="/docs/">Read the docs</a>
        </div>
        <p class="fine">Free and open source · macOS on Apple silicon, Windows from source, headless hosts for Linux · Early, expect rough edges</p>
      </section>

      <section class="window" aria-label="Adroit's window">
        <AppWindow />
      </section>

      <section class="pillars" aria-labelledby="pillars-title">
        <h2 id="pillars-title">The hand on the work</h2>
        <p class="section-lede">
          Many tools run agents for you. Adroit is for working with them yourself, at the pace of your attention and your
          review, and for that to feel like editing rather than operating a dashboard.
        </p>
        <ol class="pillar-list">
          {
            pillars.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                <dl class="keys">
                  {p.keys.map(([k, what]) => (
                    <div>
                      <dt>
                        {k.split(" ").map((key) => (
                          <kbd>{key}</kbd>
                        ))}
                      </dt>
                      <dd>{what}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="ground" aria-labelledby="ground-title">
        <h2 id="ground-title">And the ground under it</h2>
        <p class="section-lede">What any place for agent sessions has to do well, done so it never gets in the way.</p>
        <ul class="ground-list">
          {
            ground.map((g) => (
              <li>
                <h3>
                  <a href={g.href}>{g.title}</a>
                </h3>
                <p>{g.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="tree-section" aria-labelledby="tree-title">
        <div class="tree-copy">
          <h2 id="tree-title">Start by choosing where. Nothing else.</h2>
          <p>
            Press <kbd>Mod+p</kbd>, pick a directory from those already in use, from your ghq repositories or from a file
            tree, and write the first prompt. The session lands in the tree under its repository, and its agent names it
            once it knows what the work is.
          </p>
          <p>
            No project to set up, no task to declare. What the work turns out to be shows as you go. With no directory at
            all, a <a href="/docs/getting-started/#scratch-sessions">scratch session</a> talks it through and hands the work to a
            session in the project once it turns into one.
          </p>
          <p>
            Not cloned yet? Type <code>github.com/owner/repo</code>, or <code>github:</code> to look through GitHub, and the
            picker clones it with ghq.
          </p>
        </div>
        <Screenshot
          name="picker"
          alt="Adroit's picker, titled Go to a session, or start one, with github.com/acme/web typed: two ghq repositories offered to start in, and a row to clone github.com/acme/web with ghq."
          width={1600}
          height={1053}
        />
      </section>

      <section class="tree-section is-flipped" aria-labelledby="shells-title">
        <div class="tree-copy">
          <h2 id="shells-title">A shell where the work is.</h2>
          <p>
            Press <kbd>Mod+s</kbd> and a shell opens in the current worktree, listed under its{" "}
            <strong>Terminals</strong> beside that worktree's sessions and files. Run the build or the tests there, and read
            them in the same window.
          </p>
          <p>
            Like a session, a shell keeps running when the window closes. Sessions can start one too, so a dev server or a
            probe an agent runs is in the tree where you can see it, not hidden in the background.
          </p>
          <p class="more"><a href="/docs/terminals/">Shells and terminals</a></p>
        </div>
        <Screenshot
          name="console"
          alt="Adroit's window with the api repository's terminals in the tree, a cargo run terminal serving requests split above a shell showing git status and log, and the details panel on its Overview tab with the machine's meters."
          width={1600}
          height={1053}
        />
      </section>

      <section class="tree-section" aria-labelledby="docs-title">
        <div class="tree-copy">
          <h2 id="docs-title">Read what the work wrote.</h2>
          <p>
            A Markdown document opens in a viewer drawn in Adroit's theme, as GitHub would draw it: tables, highlighted
            code, alerts, formulas and Mermaid diagrams included. It follows the file as the agent changes it, at the place
            you were reading.
          </p>
          <p>
            Press <kbd>e</kbd> and the same window switches to Neovim on the document, and back. Images a session draws
            open in a lightbox, one key from the next.
          </p>
          <p class="more"><a href="/docs/window/#viewers">Viewers</a></p>
        </div>
        <Screenshot
          name="markdown"
          alt="The api repository's README.md opened from the tree's Files in Adroit's Markdown viewer, showing code blocks, a table of endpoints and a flowchart drawn from Mermaid, beside the tree with changed files marked."
          width={1600}
          height={1053}
        />
      </section>

      <section class="tree-section is-flipped" aria-labelledby="panel-title">
        <div class="tree-copy">
          <h2 id="panel-title">The details, arranged your way.</h2>
          <p>
            The details panel tells about what you are looking at: the session and its change, the timeline its agent
            records, its prompts and messages, the files and links it brought up, the account's limits and the machine's
            load.
          </p>
          <p>
            Each of these is a component. Drag them onto tabs of your own, or onto the foot shown under every tab, on a
            picture of the panel in Settings.
          </p>
          <p class="more"><a href="/docs/details/">The details panel</a></p>
        </div>
        <Screenshot
          name="settings"
          alt="Adroit's Settings window on Details panel: a picture of the panel's Overview tab with a sample session and a foot of context, limits, CPU and memory, beside the tab's name and icon and the list of components to drag onto it."
          width={1600}
          height={1186}
        />
      </section>

      <section class="not" aria-labelledby="not-title">
        <h2 id="not-title">What Adroit is not</h2>
        <ul class="not-list">
          <li>
            <strong>Not a chat view.</strong> It never rebuilds an agent's screen from structured output. An agent behaves in
            Adroit as it does in a terminal.
          </li>
          <li>
            <strong>Not an orchestrator.</strong> No session runs others as its workers. Each one plans and does its own work
            and answers to you.
          </li>
          <li>
            <strong>Not an editor.</strong> Files, logs and diffs are there to be read. Real editing happens in your usual
            editor, which Adroit opens beside the sessions.
          </li>
        </ul>
        <p class="more"><a href="/docs/concept/">The concept behind it</a></p>
      </section>

      <section id="install" aria-labelledby="install-title">
        <div class="install">
          <h2 id="install-title">Install</h2>
          <p class="section-lede">
            Adroit needs git and at least one supported agent on your <code>PATH</code>. jj, ghq and the GitHub CLI are
            used when installed.
          </p>
          <div class="install-ways">
            <div class="install-way">
              <h3>Homebrew</h3>
              <p>The released app, for Apple silicon Macs.</p>
              <code>brew install --cask adroit-app/tap/adroit</code>
            </div>
            <div class="install-way">
              <h3>Nix</h3>
              <p>The same build from the flake, prebuilt in Cachix.</p>
              <code>nix profile install github:adroit-app/Adroit</code>
            </div>
          </div>
          <div class="actions">
            <a class="button is-primary" href="/docs/install/">Install guide</a>
            <a class="button" href="/docs/getting-started/">Getting started</a>
            <a class="button" href={repository}>Source on GitHub</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img class="on-light" src="/logo/adroit-mark-32.svg" alt="" width="32" height="32" />
        <img class="on-dark" src="/logo/adroit-mark-32-light.svg" alt="" width="32" height="32" />
        <p>Adroit is a workbench for working with coding agents by hand.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/docs/">Docs</a>
        <a href="/docs/concept/">Concept</a>
        <a href={repository}>Source code</a>
        <a href={`${repository}/issues`}>Report a problem</a>
      </nav>
      <p class="footer-legal">
        Adroit is MIT licensed. The Adroit name and logo are not covered by that licence. Claude Code, Codex, Pi, OpenCode
        and Neovim belong to their owners.
      </p>
    </footer>
  </body>
</html>
