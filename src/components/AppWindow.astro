---
/**
 * Adroit's main window, drawn as the app draws it: the same panels, rows,
 * tabs, window strips, prompt card, details and status bar, in the colours of
 * its default theme (crates/window/assets/css in the Adroit repository),
 * scaled as one piece. The agents' consoles are a sketch: what they show is
 * their own interface.
 */
import Icon from "./Icon.astro";
---

<figure class="shot">
  <div class="app" aria-hidden="true">
    <div class="titlebar">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="title">Adroit</span>
    </div>

    <div class="header">
      <span class="toggle on"><Icon name="layout-sidebar" /></span>
      <span class="crumbs">
        <span class="crumb is-env"><Icon name="device-desktop" />This Mac</span>
        <span class="sep"><Icon name="chevron-right" /></span>
        <span class="crumb"><Icon name="folder" />api</span>
        <span class="sep"><Icon name="chevron-right" /></span>
        <span class="crumb is-path"><Icon name="git-branch" />~/src/api</span>
        <span class="sep"><Icon name="chevron-right" /></span>
        <span class="crumb">auth-revamp</span>
      </span>
      <span class="spacer"></span>
      <span class="chip is-wait"><span class="glyph wait"><Icon name="bell" /></span>1 waiting</span>
      <span class="chip"><span class="glyph run"><Icon name="loader-2" /></span>1 working</span>
      <span class="toggle on"><Icon name="layout-sidebar-right" /></span>
      <span class="toggle"><Icon name="settings" /></span>
    </div>

    <div class="body">
      <aside class="panel tree">
        <div class="bar">
          <span class="filter"><Icon name="filter" /><span class="placeholder">Filter</span></span>
          <span class="tool"><Icon name="list-tree" /></span>
          <span class="tool"><Icon name="plus" /></span>
        </div>
        <div class="rows">
          <div class="row env">
            <span class="mark"><Icon name="chevron-down" /></span><i class="dot"></i><span class="kind"><Icon name="device-desktop" /></span><span class="name">This Mac</span><span class="start"><Icon name="plus" /></span>
          </div>
          <div class="row head d1">
            <span class="mark"><Icon name="folder-open" /></span><span class="name">api</span><span class="start"><Icon name="plus" /></span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-down" /></span><span class="name">Sessions</span><span class="meta">3</span>
          </div>
          <div class="row d3 shown">
            <span class="glyph run"><Icon name="loader-2" /></span><span class="name">auth-revamp</span><span class="meta">k3qz</span><span class="where">1</span><span class="badge">Claude Code</span>
          </div>
          <div class="row d3">
            <span class="glyph done"><Icon name="check" /></span><span class="name">review-api</span><span class="meta">m7wp</span><span class="where">1</span><span class="badge">Codex</span>
          </div>
          <div class="row d3">
            <span class="glyph wait"><Icon name="bell" /></span><span class="name">implement</span><span class="meta">x2rd</span><span class="where">2</span><span class="badge">Pi</span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-down" /></span><span class="name">Terminals</span><span class="meta">1</span>
          </div>
          <div class="row d3 term">
            <span class="mark"><Icon name="terminal" /></span><span class="name">npm run dev</span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-right" /></span><span class="name">Pull Requests</span><span class="meta">3</span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-right" /></span><span class="name">Issues</span><span class="meta">12</span>
          </div>
          <div class="row worktree d2">
            <span class="mark"><Icon name="git-branch" /></span><span class="name">main</span><span class="start"><Icon name="plus" /></span>
          </div>
          <div class="row worktree d2">
            <span class="mark"><Icon name="git-branch" /></span><span class="name">feat/oauth</span><span class="start"><Icon name="plus" /></span>
          </div>
          <div class="row head d1">
            <span class="mark"><Icon name="folder-open" /></span><span class="name">notes</span><span class="start"><Icon name="plus" /></span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-right" /></span><span class="name">Files</span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-down" /></span><span class="name">Sessions</span><span class="meta">1</span>
          </div>
          <div class="row d3">
            <span class="glyph idle"><Icon name="circle" /></span><span class="name">outline-the-talk</span><span class="meta">p9fe</span><span class="badge">Claude Code</span>
          </div>
          <div class="row group d2">
            <span class="mark"><Icon name="chevron-down" /></span><span class="name">Terminals</span>
          </div>
          <div class="row add-env">
            <span class="mark"><Icon name="plus" /></span><span class="name">Add environment…</span>
          </div>
        </div>
        <div class="divider"></div>
        <div class="inbox">
          <div class="row">
            <span class="glyph wait"><Icon name="bell" /></span>
            <span class="inbox-text">
              <span class="name">implement</span>
              <span class="sub">api · Bash: npm test</span>
            </span>
            <span class="badge">Pi</span>
          </div>
        </div>
      </aside>

      <section class="panel center is-focused">
        <div class="tabs">
          <span class="tabs-where">api</span>
          <span class="tab active">
            <span class="num">1</span><span class="glyph run"><Icon name="loader-2" /></span>auth-revamp<span class="code">k3qz</span><span class="num">2</span><span class="close"><Icon name="x" /></span>
          </span>
          <span class="tab">
            <span class="num">2</span><span class="glyph wait"><Icon name="bell" /></span>implement<span class="code">x2rd</span><span class="num">1</span><span class="close"><Icon name="x" /></span>
          </span>
          <span class="tab">
            <span class="num">3</span>README.md<span class="num">1</span><span class="close"><Icon name="x" /></span>
          </span>
        </div>
        <div class="windows">
          <div class="win is-left focused">
            <div class="win-bar">
              <span class="glyph run"><Icon name="loader-2" /></span>
              <span class="win-name">auth-revamp</span>
              <span class="badge">Claude Code</span>
              <span class="spacer"></span>
              <span class="win-where">api</span>
              <span class="close"><Icon name="x" /></span>
            </div>
            <div class="console">
              <p class="you">&gt; Rotate refresh tokens in auth middleware</p>
              <p><b class="ok">●</b> Read <span class="dim">src/auth/middleware.ts</span></p>
              <p><b class="ok">●</b> Update <span class="dim">src/auth/refresh.ts</span></p>
              <p class="diff del">&nbsp;&nbsp;- return issue(token)</p>
              <p class="diff add">&nbsp;&nbsp;+ revoke(token.family)</p>
              <p class="diff add">&nbsp;&nbsp;+ return issue(rotate(token))</p>
              <p><b class="ok">●</b> Bash <span class="dim">npm test -- auth</span></p>
              <p class="dim">&nbsp;&nbsp;⎿ 41 passed, 1 failed</p>
              <p><b class="busy">✻</b> <span class="busy">Fixing the reuse check…</span> <span class="dim">(38s)</span></p>
            </div>
            <div class="prompt">
              <div class="prompt-grid">
                <p>Also cover a refresh token that is</p>
                <p>reused after rotation<i class="cursor"></i></p>
              </div>
              <div class="prompt-foot">
                <span class="target"><Icon name="arrow-right" />auth-revamp</span>
                <span class="spacer"></span>
                <span class="hint"><kbd>Ctrl+Enter</kbd> send</span>
              </div>
            </div>
          </div>
          <div class="win is-right">
            <div class="win-bar">
              <span class="glyph done"><Icon name="check" /></span>
              <span class="win-name">review-api</span>
              <span class="badge">Codex</span>
              <span class="spacer"></span>
              <span class="win-where">api</span>
              <span class="close"><Icon name="x" /></span>
            </div>
            <div class="console">
              <p class="you">› Check every handler for auth</p>
              <p><b class="dim">•</b> Explored</p>
              <p class="dim">&nbsp;&nbsp;└ Search requireAuth in routes</p>
              <p><b class="dim">•</b> Two handlers skip the check:</p>
              <p>&nbsp;&nbsp;1. <span class="code">GET /export</span></p>
              <p>&nbsp;&nbsp;2. <span class="code">POST /webhooks/retry</span></p>
              <p><b class="dim">•</b> Both are fixed in the diff,</p>
              <p>&nbsp;&nbsp;with a test for each.</p>
            </div>
          </div>
        </div>
      </section>

      <aside class="panel details">
        <div class="sheets">
          <span class="sheet active"><Icon name="layout-dashboard" />Overview</span>
          <span class="sheet"><Icon name="git-branch" /></span>
          <span class="sheet"><Icon name="timeline-event" /></span>
          <span class="sheet"><Icon name="message" /></span>
          <span class="sheet"><Icon name="link" /></span>
        </div>
        <div class="block">
          <div class="label">auth-revamp</div>
          <dl class="facts">
            <dt>Model</dt><dd>opus</dd>
            <dt>State</dt><dd><span class="state run">working</span></dd>
            <dt>Started</dt><dd>14m ago</dd>
            <dt>Last input</dt><dd>2m ago</dd>
          </dl>
        </div>
        <div class="block">
          <div class="change">
            <Icon name="git-commit" /><span class="commit">a41c9e2</span><span class="subject">auth: rotate refresh tokens</span><span class="tag">3 files</span>
          </div>
        </div>
        <div class="block">
          <div class="card">
            <div class="card-head"><span class="mark"><Icon name="chevron-down" /></span><span class="glyph run"><Icon name="loader-2" /></span><span class="name">Rotate refresh tokens</span><span class="dim">3/5</span></div>
            <i class="progress" style="--p-done: 60%; --p-run: 20%"></i>
            <div class="task"><span class="glyph done"><Icon name="check" /></span><span class="name">Find every issuer</span></div>
            <div class="task"><span class="glyph done"><Icon name="check" /></span><span class="name">Revoke the family on reuse</span></div>
            <div class="task"><span class="glyph run"><Icon name="loader-2" /></span><span class="name">Fix the reuse test</span></div>
            <div class="task"><span class="glyph idle"><Icon name="circle" /></span><span class="name">Update the API docs</span></div>
          </div>
        </div>
        <div class="block folded">
          <div class="fold"><span class="mark"><Icon name="chevron-right" /></span><span class="label">Running</span><span class="tag">2</span></div>
          <div class="fold"><span class="mark"><Icon name="chevron-right" /></span><span class="label">About</span><span class="tag">4</span></div>
        </div>
        <div class="foot">
          <div class="gauge">
            <div class="gauge-head"><span class="gauge-label">Context</span><span class="gauge-left">24%</span></div>
            <i class="track" style="--v: 24%; --c: var(--ctx)"></i>
            <span class="gauge-note">48k / 200k tokens</span>
          </div>
          <div class="gauges">
            <div class="gauge">
              <div class="gauge-head"><span class="gauge-label">Session limit</span><span class="gauge-left">62% left</span></div>
              <i class="track" style="--v: 38%; --c: var(--run)"></i>
              <span class="gauge-note">resets 15:00</span>
            </div>
            <div class="gauge">
              <div class="gauge-head"><span class="gauge-label">Weekly limit</span><span class="gauge-left">81% left</span></div>
              <i class="track" style="--v: 19%; --c: var(--run)"></i>
              <span class="gauge-note">resets Mon</span>
            </div>
          </div>
          <div class="gauges">
            <div class="gauge">
              <div class="gauge-head"><span class="gauge-label"><Icon name="cpu" />CPU</span><span class="gauge-left">31%</span></div>
              <i class="track" style="--v: 31%; --c: var(--ctx)"></i>
              <span class="gauge-note">Apple M4 Pro</span>
            </div>
            <div class="gauge">
              <div class="gauge-head"><span class="gauge-label"><Icon name="memory" />Memory</span><span class="gauge-left">57%</span></div>
              <i class="track" style="--v: 57%; --c: var(--done)"></i>
              <span class="gauge-note">18.2 / 32.0 GiB</span>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="footer">
      <span class="mode">INSERT</span>
      <span class="spacer"></span>
      <span class="hint"><kbd>Ctrl+q</kbd><kbd>h</kbd><kbd>j</kbd><kbd>k</kbd><kbd>l</kbd> move</span>
      <span class="hint"><kbd>Ctrl+q</kbd><kbd>T</kbd> to new tab</span>
      <span class="hint"><kbd>Ctrl+q</kbd><kbd>M</kbd> merge into tab before</span>
      <span class="hint"><kbd>Cmd+j</kbd> next waiting</span>
    </div>
  </div>
  <figcaption>
    Adroit's window: on the left the tree of sessions by repository, with its terminals, pull requests, issues and
    worktrees, and the session waiting on you listed again at the bottom; in the middle a tab holding a Claude Code
    session and a Codex session side by side, each in its own interface, with a prompt written in Neovim; on the right
    the details of the focused session, the timeline its agent records of its work, and its usage.
  </figcaption>
</figure>

<style>
  /* The window is laid out at 1280 by 740 points; one --u is one of them. */
  .shot {
    container-type: inline-size;
    margin: 0;
  }
  .app {
    --u: calc(100cqw / 1280);
    --ground: #131a24;
    --panel: #192330;
    --raised: #242d3a;
    --select: #2f3843;
    --line: #29323e;
    --line-strong: #38404b;
    --focus-line: #3d4550;
    --focus-border: #4f5660;
    --text: #cdcecf;
    --text-2: #9b9ea2;
    --text-3: #7c8187;
    --text-4: #5d636c;
    --wait: #dbc074;
    --run: #719cd6;
    --done: #81b29a;
    --fail: #c94f6d;
    --ctx: #63cdcf;
    --wait-tint: rgba(219, 192, 116, 0.16);
    --wait-tint-soft: rgba(219, 192, 116, 0.12);
    --run-tint: rgba(113, 156, 214, 0.16);
    --run-tint-soft: rgba(113, 156, 214, 0.08);
    --done-tint: rgba(129, 178, 154, 0.14);
    --sans: -apple-system, BlinkMacSystemFont, "Helvetica Neue", system-ui, sans-serif;
    --mono: var(--adroit-font-mono);

    display: flex;
    flex-direction: column;
    aspect-ratio: 1280 / 740;
    overflow: hidden;
    border: 1px solid #000;
    border-radius: calc(12 * var(--u));
    color: var(--text);
    background: var(--ground);
    box-shadow:
      0 calc(30 * var(--u)) calc(80 * var(--u)) rgb(0 0 0 / 0.28),
      0 0 0 calc(1 * var(--u)) rgb(255 255 255 / 0.06) inset;
    font-family: var(--sans);
    font-size: calc(13 * var(--u));
    line-height: 1.35;
    text-align: left;
  }
  .app :global(.icon) {
    display: inline-flex;
    flex: none;
  }
  .app :global(.icon svg) {
    width: calc(14 * var(--u));
    height: calc(14 * var(--u));
    stroke-width: 1.75;
  }
  .app p,
  .app dl,
  .app dd {
    margin: 0;
  }
  .spacer {
    flex: 1;
  }
  .dim {
    color: var(--text-3);
  }

  /* The title bar macOS draws over the window. */
  .titlebar {
    flex: none;
    position: relative;
    display: flex;
    align-items: center;
    height: calc(28 * var(--u));
    padding: 0 calc(12 * var(--u));
    background: #2a2d33;
    border-bottom: 1px solid #000;
  }
  .lights {
    display: flex;
    gap: calc(8 * var(--u));
  }
  .lights i {
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3) {
    background: #28c840;
  }
  .title {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #b8babd;
    font-size: calc(13 * var(--u));
    font-weight: 600;
  }

  .header {
    flex: none;
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    height: calc(40 * var(--u));
    padding: 0 calc(16 * var(--u));
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(26 * var(--u));
    height: calc(24 * var(--u));
    color: var(--text-3);
  }
  .toggle.on {
    color: var(--text-2);
  }
  .toggle :global(.icon svg) {
    width: calc(16 * var(--u));
    height: calc(16 * var(--u));
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    color: var(--text-2);
    white-space: nowrap;
  }
  .crumb {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--u));
  }
  .crumb :global(.icon) {
    color: var(--text-3);
  }
  .crumb.is-env {
    color: var(--text);
  }
  .crumb.is-path {
    font-family: var(--mono);
    font-size: calc(12 * var(--u));
  }
  .sep {
    display: inline-flex;
    color: var(--text-4);
  }
  .sep :global(.icon svg) {
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--u));
    height: calc(22 * var(--u));
    padding: 0 calc(10 * var(--u));
    border-radius: calc(11 * var(--u));
    background: var(--panel);
    color: var(--text-2);
    font-size: calc(12 * var(--u));
  }
  .chip.is-wait {
    background: var(--wait-tint-soft);
    color: var(--wait);
    font-weight: 500;
  }
  .chip :global(.icon svg) {
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
  }

  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    gap: calc(8 * var(--u));
    padding: 0 calc(8 * var(--u));
  }
  .panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(10 * var(--u));
    background: var(--panel);
  }
  .panel.is-focused {
    border-color: var(--focus-line);
  }
  .tree {
    flex: none;
    width: calc(332 * var(--u));
  }
  .center {
    flex: 1;
    min-width: 0;
  }
  .details {
    flex: none;
    width: calc(290 * var(--u));
  }

  .bar {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    margin-bottom: calc(8 * var(--u));
    padding: calc(8 * var(--u)) calc(10 * var(--u));
    border-bottom: 1px solid var(--line);
  }
  .filter {
    flex: 1;
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    padding: calc(4 * var(--u)) calc(8 * var(--u));
    border-radius: calc(6 * var(--u));
    background: var(--raised);
    color: var(--text-3);
    font-size: calc(12 * var(--u));
  }
  .filter :global(.icon svg) {
    width: calc(13 * var(--u));
    height: calc(13 * var(--u));
  }
  .tool,
  .start,
  .close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    color: var(--text-3);
  }
  .start {
    margin-left: auto;
  }

  /* A row is indented 14 points for each level under the environment. */
  .rows {
    flex: 1;
    min-height: 0;
    padding: 0 calc(8 * var(--u)) calc(8 * var(--u));
  }
  .row {
    display: flex;
    align-items: center;
    gap: calc(8 * var(--u));
    height: calc(26 * var(--u));
    padding: 0 calc(8 * var(--u));
    border-radius: calc(6 * var(--u));
    white-space: nowrap;
    overflow: hidden;
  }
  .row .name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row.d1 {
    padding-left: calc(22 * var(--u));
  }
  .row.d2 {
    padding-left: calc(36 * var(--u));
  }
  .row.d3 {
    padding-left: calc(50 * var(--u));
  }
  .row.env {
    height: calc(30 * var(--u));
    gap: calc(7 * var(--u));
    font-weight: 500;
  }
  .row.env .kind {
    display: inline-flex;
    color: var(--text-2);
  }
  .row.env .dot {
    flex: none;
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    border-radius: 50%;
    background: var(--done);
  }
  .row.head {
    font-weight: 500;
  }
  .row.group {
    height: calc(24 * var(--u));
    color: var(--text-3);
    font-size: calc(11.5 * var(--u));
    font-weight: 500;
  }
  .row.worktree {
    color: var(--text-2);
    font-family: var(--mono);
    font-size: calc(12 * var(--u));
  }
  .row.term .name {
    font-family: var(--mono);
    font-size: calc(12 * var(--u));
  }
  .row.shown {
    border-radius: 0 calc(6 * var(--u)) calc(6 * var(--u)) 0;
    background: var(--run-tint-soft);
    box-shadow: inset calc(3 * var(--u)) 0 0 var(--run);
  }
  .row.shown .name {
    font-weight: 600;
  }
  .row.add-env {
    margin-top: calc(8 * var(--u));
    border: 1px dashed var(--line-strong);
    color: var(--text-2);
  }
  .mark {
    display: inline-flex;
    flex: none;
    color: var(--text-3);
  }
  .row.head .mark,
  .row.shown .mark {
    color: var(--text-2);
  }
  .meta {
    flex: none;
    color: var(--text-3);
    font-size: calc(11.5 * var(--u));
  }
  .row.group .meta {
    font-family: var(--mono);
    font-size: calc(10.5 * var(--u));
  }
  .where {
    flex: none;
    padding: 0 calc(5 * var(--u));
    border-radius: calc(4 * var(--u));
    background: var(--raised);
    color: var(--text-3);
    font-family: var(--mono);
    font-size: calc(10 * var(--u));
    line-height: calc(16 * var(--u));
  }
